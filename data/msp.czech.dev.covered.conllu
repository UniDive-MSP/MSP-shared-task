# sent_id = cmpr9415-005-p9s3
# text = Dálnice do Québeku byla perfektně čistá, stejně jako ulice v samotném městě.

# newpar id = cmpr9415-005-p10
# sent_id = cmpr9415-005-p10s1
# text = Tvrdý boj o trh

# newpar id = cmpr9415-005-p11
# sent_id = cmpr9415-005-p11s1
# text = Kanada je uznávanou kolébkou ledního hokeje, který se zde hrál prvně v roce 1879.

# sent_id = cmpr9415-005-p11s2
