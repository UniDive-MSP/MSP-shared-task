# newpar id = cmpr9413-047-p21
# sent_id = cmpr9413-047-p21s1
# text = Proti koupání ve vaně ušetříte.

# sent_id = cmpr9413-047-p21s2
# text = Běžnou sprchou proteče 6-12 litrů vody za minutu podle síly proudu, typu růžice apod.

# sent_id = cmpr9413-047-p21s3
# text = Počítejme 8 l/min. a sprchu 5 minut včetně seřízení teploty vody.

# sent_id = cmpr9413-047-p21s4
