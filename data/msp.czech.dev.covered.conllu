# newpar id = cmpr9413-047-p23
# sent_id = cmpr9413-047-p23s1
# text = Sprcha celkem 1.84 Kč.

# newpar id = cmpr9413-047-p25
# sent_id = cmpr9413-047-p25s1
# text = Instalujete stop-ventil (100 Kč), kterým zastavíte průtok při mydlení či mytí vlasů.

# sent_id = cmpr9413-047-p25s2
