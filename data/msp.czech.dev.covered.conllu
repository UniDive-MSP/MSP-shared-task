# sent_id = ln95045-088-p2s3
# text = O jednání se však definitivně rozhodne přímo dnes, kdy budou členové orgánu přítomni v budově Poslanecké sněmovny na jednání svých "mateřských" parlamentních výborů.

# newpar id = ln95045-088-p3
