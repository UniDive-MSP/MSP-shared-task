# newdoc id = ln94209-76
# global.Entity = eid-etype-head-other
# newpar id = ln94209-76-p1
# sent_id = ln94209-76-p1s1
# text = Opera má úspěch, ale příliš experimentuje

# newpar id = ln94209-76-p2
# sent_id = ln94209-76-p2s1A
# text = Ivan Hartman, Teplice

# sent_id = ln94209-76-p2s1B
# text = Jestli se někdy vrátím do Teplic?

# sent_id = ln94209-76-p2s2
# text = zopakoval Peter Dvorský otázku.

# sent_id = ln94209-76-p2s3
# text = To bude samozřejmě záviset na mém programu, ale pak bych prosil o větší sál, tak asi pro pět tisíc lidí, řekl den před svým včerejším koncertem v Teplicích slovenský tenorista světového věhlasu.

# sent_id = ln94209-76-p2s4
# text = Peter Dvorský vystoupil včera večer v Domě kultury doprovázen Severočeskou filharmonií řízenou jejím šéfdirigentem Tomášem Koutníkem.

# sent_id = ln94209-76-p2s5
# text = Zájem o jeho recitál třikrát převýšil nabídku asi sedmi set míst.

# newpar id = ln94209-76-p3
# sent_id = ln94209-76-p3s1
# text = Pořadatelem výjimečné akce byla akciová společnost Glavunion, která podle slov svého generálního ředitele Štěpána Popoviče chce vrátit Teplicím to, co je dělalo velkými- dobrou hudbu.

# sent_id = ln94209-76-p3s2
# text = Tento koncert není naší poslední akcí, potvrdil ředitel Popovič.

# newpar id = ln94209-76-p4
# sent_id = ln94209-76-p4s1
# text = Peter Dvorský se bude po návratu z Teplic domů připravovat na premiéru Pucciniho Bohémy, která je v Bratislavě ohlášena na 7. října.

# sent_id = ln94209-76-p4s2
# text = Shodou okolností právě role Rudolfa z této opery byla pro Dvorského vstupenkou mezi světovou operní elitu.

# sent_id = ln94209-76-p4s3
# text = Rudolfem Dvorský debutoval v milánské La Scale na Velký pátek 13. dubna 1979.

# sent_id = ln94209-76-p4s4
# text = Šlo o rychle přijatou nabídku.

# sent_id = ln94209-76-p4s5
# text = S kolegy jsem se seznámil až po prvním dějství, řekl Peter Dvorský.

# sent_id = ln94209-76-p4s6
# text = Potom jsem měl plný kalendář, dodal.

# sent_id = ln94209-76-p4s7
# text = Téhož roku v červenci už zpíval i v dalším prestižním sále, ve veronské Aréně.

# newpar id = ln94209-76-p5
# sent_id = ln94209-76-p5s1
# text = Podle Petera Dvorského, který každé představení prožívá jako neopakovatelnou událost, znamená pro mladého umělce velký úspěch už to, že vůbec poprvé vystoupí na jevišti.

# sent_id = ln94209-76-p5s2
# text = Vždyť je třeba dát dohromady talent, odvahu a štěstí.

# sent_id = ln94209-76-p5s3
# text = Když jedno chybí, nepodaří se to.

# sent_id = ln94209-76-p5s4
# text = Také je třeba mít zdravé nervy, ale těch mi už trochu ubývá, řekl umělec.

# newpar id = ln94209-76-p6
# sent_id = ln94209-76-p6s1
# text = Peter Dvorský se nedomnívá, že by klesal zájem o operu.

# sent_id = ln94209-76-p6s2
# text = Spíš naopak.

# sent_id = ln94209-76-p6s3
# text = Opera se ale ubírá jiným směrem a na operních pódiích se velmi experimentuje.

# sent_id = ln94209-76-p6s4
# text = Bojím se, že pokud inscenování oper opustí tradiční podobu, dostane se opera do úzkých a spíš bude vyhledávat koncertní provedení.

# sent_id = ln94209-76-p6s5
# text = Naše děti si pak nebudou umět představit Rusalku a Vodníka.

# sent_id = ln94209-76-p6s6
# text = Mladí režiséři totiž často pokládají klasické inscenace za kýč.

# sent_id = ln94209-76-p6s7
# text = Peter Dvorský také připomněl veliký zájem mladých amerických umělců o angažmá na evropských operních scénách.

# newpar id = ln94209-76-p7
# sent_id = ln94209-76-p7s1
# text = O politice Peter Dvorský mluví nerad.

# sent_id = ln94209-76-p7s3
# text = Přestože přede dvěma roky dostal nabídku kandidovat do parlamentu, říká, že by do politiky rozhodně nevstoupil.

# sent_id = ln94209-76-p7s4
# text = Nechci, aby na mě lidé plivali v politickém křesle, to ať raději plivají, když se mi něco nepovede na jevišti.

# sent_id = ln94209-76-p7s5
# text = Chystaných voleb na Slovensku se Peter Dvorský nezúčastní, neboť v té době bude v zahraničí.

# sent_id = ln94209-76-p7s6
# text = Zase mě moje umění zachrání, žertoval.

# newpar id = ln94209-76-p8
# sent_id = ln94209-76-p8s1
# text = Peter Dvorský je však prezidentem humanitární nadace Harmony a od roku 1991 také předsedou rady Slovenské hudební unie.

# sent_id = ln94209-76-p8s2
# text = Na otázku LN, co chce v této funkci prosazovat, Peter Dvorský odpověděl, že je třeba vyřešit vztahy mezi státními a soukromými uměleckými školami.

# sent_id = ln94209-76-p8s3
# text = Existují tendence dostat školy do soukromých rukou, což není vždy správné.

# sent_id = ln94209-76-p8s4
# text = Umění se nerodí jen v dobře situovaných rodinách.

# sent_id = ln94209-76-p8s5
# text = Talentované děti z méně mohovitých rodin, nebudou- li mít na školné, zbrzdí svůj talent a nebudou se moci rozvíjet.

# sent_id = ln94209-76-p8s6
# text = Chceme prosazovat, aby se úroveň uměleckých škol zlepšila, řekl Peter Dvorský.

# newdoc id = ln94209-85
# global.Entity = eid-etype-head-other
