# newpar id = ln95048-050-p28
# sent_id = ln95048-050-p28s1
# text = S Jaroslavem Vokřálem máme už rok připravený scénář Vražedné počasí.

# sent_id = ln95048-050-p28s2
# text = Jde o kriminální melodrama ze současné Prahy o únosci a jeho oběti, které jsme napsali pro Sagvana Tofiho.

# sent_id = ln95048-050-p28s3
# text = Seženeme-li peníze, chtěli bychom začít na podzim.

# sent_id = ln95048-050-p28s4
