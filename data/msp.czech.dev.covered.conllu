# newdoc id = ln94204-149
# global.Entity = eid-etype-head-other
# newpar id = ln94204-149-p1
# sent_id = ln94204-149-p1s1
# text = Literární časopis pro Evropu

# sent_id = ln94204-149-p2s1B
# text = V německém Offenbachu vychází časopis, jehož úroveň i zaměření svědčí o tom, že ve stínu německého knižního a literárního centra, jakým je nedaleký Frankfurt nad Mohanem, nemusí dobrá literatura nevyhnutelně živořit.

# sent_id = ln94204-149-p2s2
# text = Časopis, o kterém je řeč, se jmenuje NEUE LITERATUR.

# sent_id = ln94204-149-p2s3
# text = Vydává ho Gerhard Csejka, Němec pocházející z Rumunska.

# sent_id = ln94204-149-p2s4
# text = Tzv. nová série tohoto časopisu pro příčné spojení, jak zní jeho podtitul, začala vycházet v Německu v roce 1992.

# sent_id = ln94204-149-p2s5
# text = Tehdy se jeho šéfredaktor rozhodl přestěhovat redakci z Bukurešti do Offenbachu.

# newpar id = ln94204-149-p3
# sent_id = ln94204-149-p3s1
# text = Zdá se, že to byl šťastný krok: provinční rumunský časopis, který po druhé světové válce založil komunistický Svaz spisovatelů, se vyhranil jako médium autorů kvalitní literatury z celé Evropy - a navíc pro evropského čtenáře.

# newpar id = ln94204-149-p4
# sent_id = ln94204-149-p4s1
# text = Jednotlivá čísla jsou věnována speciálním tématům, například literatuře v bojující bývalé Jugoslávii nebo multikulturnosti v Rusku.

# sent_id = ln94204-149-p4s2
# text = Časopis vychází šestkrát ročně.

# sent_id = ln94204-149-p4s3
# text = Kromě uveřejňování prózy a poesie velkých evropských literatur chce redakce zvýraznit i kulturní profil jiné Evropy, který jako by koncem osmdesátých let vyhladila vlna pozápaďování.

# sent_id = ln94204-149-p4s4A
# text = Autentická tvář našeho tady a teď vypadá problematicky a časopis NEUE LITERATUR. se jí snaží nastavit zrcadlo.

# sent_id = ln94204-149-p4s4B
# text = (ab)

# newdoc id = ln94204-158
