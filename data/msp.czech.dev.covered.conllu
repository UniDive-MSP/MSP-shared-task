# sent_id = ln95047-039-p2s1B
# text = Vážím si, jak objektivně paní Šusterová mapuje nemohoucnost a neschopnost všech zainteresovaných orgánů, počínaje opakovanými sedánkami paní Keltošové a jejího apartního protějšku.

# sent_id = ln95047-039-p2s2
# text = Člověka zajisté potěší prohlášení slovenské ministryně o zájmu, který mají o "své" děti.

# sent_id = ln95047-039-p2s3
