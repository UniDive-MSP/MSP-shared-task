# text = ČMUS má výhrady k zavedení školného

# newpar id = ln95046-083-p2
# sent_id = ln95046-083-p2s1A
# text = Z politické scény

# sent_id = ln95046-083-p2s1C
# text = Českomoravská unie středu má vážné výhrady k vládní koncepci vysokého školství a zejména k institutu školného.

# sent_id = ln95046-083-p2s2
# text = Jeho uplatňování bez současného zavedení systému státní podpory považuje za předčasné a diskriminační vůči studentům bez dostatečně silného ekonomického zázemí.

# sent_id = ln95046-083-p2s3
