# sent_id = ln94210-79-p2s1B
# text = Spojené státy údajně předložily Kubě nové návrhy na zvýšení roční kvóty pro legální imigranty z ostrova.

# sent_id = ln94210-79-p2s2
# text = Američané však zatím nechtějí přesná čísla zveřejnit;

# sent_id = ln94210-79-p2s3
# text = označují je však za pružná.

# sent_id = ln94210-79-p2s4
