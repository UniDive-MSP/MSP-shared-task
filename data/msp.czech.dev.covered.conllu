# newdoc id = ln94210-97
# global.Entity = eid-etype-head-other
# newpar id = ln94210-97-p1
# sent_id = ln94210-97-p1s1
# text = Brusič Karhan po letech

# sent_id = ln94210-97-p2s1B
# text = DIVADLO: Léto se chýlí ke konci a překvapení neubývá.

# sent_id = ln94210-97-p2s2
# text = Black Box, nejdéle hrající anglické divadlo v Praze (pod různými jmény existuje totiž již od roku 1991), překvapivě ukončilo svůj letní festival (postavený letos na českých hrách) Káňovou PARTOU BRUSIČE KARHANA, uvedenou pod slušivým jménem KARHAN' S MEN.

# newpar id = ln94210-97-p3
# sent_id = ln94210-97-p3s1
# text = Čech si snad s trochou fantazie dovede představit, co může lákat čilou americkou komunitu v Praze na Čapkově R. U. R., Goldflamově Agatománii či Kohoutově Požáru v suterénu.

# sent_id = ln94210-97-p3s2
# text = Uvedení prvního socialistického výrobního dramatu, hitu sezony 1949, však Praha asi neočekávala.

# sent_id = ln94210-97-p4s2
# text = Parta lidiček v nejrůznějších modrých hadrech s kšiltovkami na hlavě nepřipomíná ani vzdáleně dobu modráků a rádiovek, svazácké mládí, košile modré, srdce rudá.

# sent_id = ln94210-97-p4s3
# text = Spíše vás napadne, že jste se ocitli v zamjatinovském světě.

# sent_id = ln94210-97-p4s4
# text = Ten pocit nevyvolává jen zvrácený optimismus bezkonfliktního příběhu, ale i okouzlující scény, v nichž parta v nezabydleném prostoru ohraničeném jen několika konstruktivistickými prvky pracuje na imaginárních strojích a přesné i plavné pohyby jejich rukou vytvářejí v prázdnu imaginární součástky.

# newpar id = ln94210-97-p5
# sent_id = ln94210-97-p5s1
# text = Režisérce se podařilo líně tekoucí děj bezpečně vygradovat až k závěrečné pointě, aniž by se uchýlila k jakékoli ironii.

# sent_id = ln94210-97-p5s2
# text = Mohla se opřít o soubor s velmi pěknou hereckou úrovní;

# sent_id = ln94210-97-p5s3
# text = vedle vynikajícího Alana Kinnairda, hrajícího starého Karhana s precizní věcností profesionála, se v něm, pravda, najdou i někteří amatéři, jejichž hraní je spíš kouzlem nechtěného.

# sent_id = ln94210-97-p5s4
# text = Dokázala, že je schopna prohlédnout budovatelskou poetiku hry a rekonstruovat její pseudořád svéráznými, ale zcela odpovídajícími prostředky, které míří k samé podstatě komunistické utopie.

# sent_id = ln94210-97-p5s5B
# text = The Black Box Summer Festival of Czech 20th Century Plays-

# sent_id = ln94210-97-p5s5C
# text = Vašek Káňa: Karhan' s Men.

# sent_id = ln94210-97-p5s6
