# sent_id = ln95045-088-p1s1
# text = Další jednání komise pro BIS se uskuteční možná již dnes

# sent_id = ln95045-088-p2s1B
# text = Další jednání parlamentního orgánu pro kontrolu činnosti Bezpečnostní informační služby (BIS) by se mohlo uskutečnit již dnes.

# sent_id = ln95045-088-p2s2
