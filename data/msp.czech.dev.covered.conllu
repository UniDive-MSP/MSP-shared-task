# newpar id = cmpr9410-049-p3
# sent_id = cmpr9410-049-p3s1
# text = Jen pomalu si zvykáme na to, že za topnou sezónu vyklopíme jako uživatelé bytu za teplo až dva měsíční platy.

# sent_id = cmpr9410-049-p3s2
