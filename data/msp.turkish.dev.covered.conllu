# old_sent_id = mst-0469
# sent_id = 00220166_14
# text = Üşümüyordum.

# old_sent_id = mst-4342
# sent_id = 00220166_15
# text = Heyecan adrenalini yükseltiyor, bu yaşamda kalma mücadelesi içinde adaleler daha da geriliyordu.

# old_sent_id = mst-2938
# sent_id = 00220166_16
# text = Rehberim Yura'nın ne kadar haklı olduğunu düşündüm.

# old_sent_id = mst-0780
# sent_id = 00220166_17
# text = Uçaktan indiğimde, Üstündekiler olmaz.

# old_sent_id = mst-3176
# sent_id = 00220166_18
# text = Sana bunları getirdim demiş, büyük bir ciddiyetle önüme atıvermişti giysileri.

# old_sent_id = mst-2063
# sent_id = 00220166_19
# text = Oysa birkaç saat önce, bu ısı kontrol teknolojisinin Batı'da satılan son örnekleriyle karın üstünde nasıl da titriyordum.

# old_sent_id = mst-4321
# sent_id = 00220166_20
