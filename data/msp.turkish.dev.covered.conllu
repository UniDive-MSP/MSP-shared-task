# old_sent_id = mst-0970
# sent_id = 00220166_21
# text = Binlerce yıllık bir geleneğin teknolojiye üstünlüğünü sembolize ediyordu bunlar.

# old_sent_id = mst-2670
# sent_id = 00220166_22
# text = Bütün bu olasılıklardan daha da can sıkıcı olanı, zamansız uyanan ayıların civarda olabileceği endişesiydi.

