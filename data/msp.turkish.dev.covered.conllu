# text = Kızak yolculuğuna alışmak kolay değildi.

# old_sent_id = mst-0602
# sent_id = 00220166_11
# text = Henüz iki saattir yoldaydık ve ben altı kez düşmüştüm.

# old_sent_id = mst-5300
# sent_id = 00220166_12
