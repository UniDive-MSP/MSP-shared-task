# sent_id = 00220166_23
# text = Baharın gelmesiyle eriyen kar suları, mağaralara girerek ayıların erken uyanmasına neden oluyor, sinirli, uykusuz ve aç ayılar, daha hırçın ve saldırganlaşıyorlardı bu dönemde.

# old_sent_id = mst-4285
# sent_id = 00220166_24
