# text = Uçucu bir bulutçuk ağdı, sararmışlığıma, tuttum biteğini.

# old_sent_id = mst-4603
# sent_id = 00196177_24
# text = Fısıldadı: Sağ ol.

# old_sent_id = mst-0996
# sent_id = 00196177_25
# text = Sen de! Ablasının eğilen başı doğruldu.

# old_sent_id = mst-5454
# sent_id = 00196177_26
# text = O daha çekici: Melez, soyu amazon belki de.

# old_sent_id = mst-4852
# sent_id = 00196177_27
# text = Kardeşini eleştiriyor gibi geldi bana, neden sokulgan onca?

# old_sent_id = mst-1456
# sent_id = 00196177_28
# text = Sen de kolluyordun canım teyzeciğim, sezdirmemeye çalışarak ikimizi...

# old_sent_id = mst-3853
# sent_id = 00196177_29
# text = Âdetim olsa bari.

# old_sent_id = mst-5101
# sent_id = 00196177_30
# text = Evet, gönlüm ablasından yanaydı.

# old_sent_id = mst-3122
# sent_id = 00196177_31
# text = Evlenseydiniz, bak nasıl üstüne titrer, çekip çevirirdi seni.

# old_sent_id = mst-3024
# sent_id = 00196177_32
# text = Ben böyle fedakar, yufka yürekli, candan insan tanımadım.

# old_sent_id = mst-2743
# sent_id = 00196177_33
# text = Kim dertli onda alır soluğu...

# old_sent_id = mst-1145
# sent_id = 00196177_34
# text = Senin ne yaptı, ne oldu?

# old_sent_id = mst-0371
# sent_id = 00196177_35
# text = Hadi hadi söyletme beni..

# old_sent_id = mst-0085
# sent_id = 00196177_36
# text = Bayağı kızıyorsun.

# old_sent_id = mst-4302
# sent_id = 00196177_37
# text = Acıyorum, içim sızlıyor o kadar.

# old_sent_id = mst-2048
# sent_id = 00196177_38
# text = Neyse, nasıl buldun öykümün girişini.

# old_sent_id = mst-2203
# sent_id = 00196177_39
# text = Nicedir elinden düşürmediği kitabını kapattı, kaldığı sayfaya kağıt sıkıştırmayı unutmayarak.

# old_sent_id = mst-4974
# sent_id = 00196177_40
# text = Kısık kısık gülüyor arada bir.

# old_sent_id = mst-3263
# sent_id = 00196177_41
# text = Çılgın karı! Ama roman mı, doktora tezi mi anlamadım.

# old_sent_id = mst-1938
# sent_id = 00196177_42
# text = Takır takır.

# old_sent_id = mst-2745
# sent_id = 00196177_43
# text = İngiliz'in ne işi var orada?

# old_sent_id = mst-1906
# sent_id = 00196177_44
# text = Amacın belli.

# old_sent_id = mst-0356
# sent_id = 00196177_45
# text = Pay çıkaracaksın kendine.

# old_sent_id = mst-2888
# sent_id = 00196177_46
# text = Üstelik özentili.

# old_sent_id = mst-4005
# sent_id = 00196177_47
# text = Eskilerin tasannu dedikleri türden.

# old_sent_id = mst-2970
# sent_id = 00196177_48
# text = Yaşlandıkça tuhaflaşıyorsun.

# old_sent_id = mst-3536
# sent_id = 00196177_49
# text = Gençliğinde yazdıklarını tercih ederim.

# old_sent_id = mst-0074
# sent_id = 00196177_50
# text = Düz, sağlam, sade...

# old_sent_id = mst-2673
# sent_id = 00196177_51
# text = Aşk öyküsü yazmayalım mı yani.

# old_sent_id = mst-4883
# sent_id = 00196177_52
# text = Kalktım, sarıldım boynuna, zoraki öptürdü pembeliğini koruyan yanaklarını.

# old_sent_id = mst-0741
# sent_id = 00196177_53
# text = İyi, iyi yeter.

# old_sent_id = mst-1081
# sent_id = 00196177_54
# text = Çay içmeyecek miyiz.

# old_sent_id = mst-4912
# sent_id = 00196177_55
# text = Enişten gelsin de...

# old_sent_id = mst-0405
# sent_id = 00196177_56
# text = Aldırma sen bana.

# old_sent_id = mst-3187
# sent_id = 00196177_57
# text = Yaz nasıl içinden geliyorsa.

# old_sent_id = mst-1195
# sent_id = 00196177_58
# text = Milletle alay eden reklamlardan iyidir...

# old_sent_id = mst-4129
# sent_id = 00196177_59
# text = (Tutkunluğumun başlangıcı, hızla düşkırıklığına dönüşmesi, boşanmayla sonuçlanan on yıllık evlilik boğuşmasından sonraki yılgın günlerime rastlıyor.

# old_sent_id = mst-5253
# sent_id = 00196177_60
# text = Evlerine sığınmıştım.

# old_sent_id = mst-4401
# sent_id = 00196177_61
# text = Teyzemden on iki yaş büyük eniştem.

# old_sent_id = mst-2485
# sent_id = 00196177_62
# text = Yaşıtım sayılır.

# old_sent_id = mst-4165
# sent_id = 00196177_63
# text = Çocukları yok.

# old_sent_id = mst-5324
# sent_id = 00196177_64
# text = Mutlu, sevginin kösteklenmediği birlikteliklerine ayak uydurmaya çalışıyordum.

# old_sent_id = mst-2651
# sent_id = 00196177_65
# text = Ne ki, zamanla yoğun sıkıntıya yolaçtı, bana göre, tekdüze, coşkusuz, amaçsız yaşam; depreşti, ölçüye sığmaz oldu içki bağımlılığım.

# old_sent_id = mst-0543
# sent_id = 00196177_66
# text = Geceleri kakıp, konuklara sunulacak rakı, votka, viski ne bulursam; birer ikişer yudum kafama dikmeden, bölük pörçük uykumu bile sürdüremiyorum.

# old_sent_id = mst-5597
# sent_id = 00196177_67
# text = Elbet ayrımındalar.

# old_sent_id = mst-4751
# sent_id = 00196177_68
# text = Açıkça kınamaktan kaçınan sabırlı davranışları cabası.

# old_sent_id = mst-2168
# sent_id = 00196177_69
# text = Kliniğe yatırma önerilerine karşı çıkamadım sonunda.

# old_sent_id = mst-5461
# sent_id = 00196177_70
# text = Adana'ya nakil girişimlerinden de haberliyim...

# old_sent_id = mst-0058
# sent_id = 00196177_71
# text = Bayındır Sokak'taki bekar evimden çıktım.

# old_sent_id = mst-5157
# sent_id = 00196177_72
# text = Philips mağazasının önünden geçmemeye özen gösteriyorum.

# old_sent_id = mst-4109
# sent_id = 00196177_73
# text = Kumru'nun ablası orada çalışıyor.

# old_sent_id = mst-2674
# sent_id = 00196177_74
# text = Dalgınlığıma geldi ya da üşendim, sapmadım ara yola...

# old_sent_id = mst-2157
# sent_id = 00196177_75
# text = Nasılsınız? Vurgu: Ortadan kayboldunuz, iyileştiniz mi?

# old_sent_id = mst-2135
# sent_id = 00196177_76
# text = Gözkulak olunması görevini üstlenmiş gibi.

# old_sent_id = mst-1752
# sent_id = 00196177_77
# text = Soğukça yanıtladım.

# old_sent_id = mst-0400
# sent_id = 00196177_78
# text = Doktorlar ara sıra görünmemi salık vermişlerdi oysa.

# old_sent_id = mst-3023
# sent_id = 00196177_79
# text = Beylik soru.

# old_sent_id = mst-2201
# sent_id = 00196177_80
# text = Yürüyelim mi biraz, sakıncası yoksa?

# old_sent_id = mst-3206
# sent_id = 00196177_81
# text = Kumru'ya gecelik bakacağım ben de...

# old_sent_id = mst-4325
# sent_id = 00196177_82
# text = Yan gözle inceleniyorum bir yandan.

# old_sent_id = mst-2772
# sent_id = 00196177_83
# text = Sinirlendim.

# old_sent_id = mst-4868
# sent_id = 00196177_84
# text = Bana ne! Yine de dayanamadım, ondan söz açmaya can atıyor belli.

# old_sent_id = mst-2768
# sent_id = 00196177_85
# text = Ne yapıyor o.

# old_sent_id = mst-0274
# sent_id = 00196177_86
# text = Anlatırım.

# old_sent_id = mst-1988
# sent_id = 00196177_87
# text = Beğenili bakışları üstümüzde gelip geçenin.

# old_sent_id = mst-3333
# sent_id = 00196177_88
# text = Yabancı havalı ya...

# old_sent_id = mst-4397
# sent_id = 00196177_89
# text = Neden bir akım oluşmadı aramızda.

# old_sent_id = mst-4995
# sent_id = 00196177_90
# text = Birden esti aklıma.

# old_sent_id = mst-3312
# sent_id = 00196177_91
# text = Aç mısın?

# old_sent_id = mst-2910
# sent_id = 00196177_92
# text = Kabayım.

# old_sent_id = mst-3805
# sent_id = 00196177_93
# text = Daha erken değil mi?

# old_sent_id = mst-3017
# sent_id = 00196177_94
# text = Uyanık inceliği.

# old_sent_id = mst-2751
# sent_id = 00196177_95
# text = Girdik Restoran Cevat'a.

# old_sent_id = mst-1186
# sent_id = 00196177_96
# text = İçmemek kararımı uyguluyorum.

# old_sent_id = mst-1838
# sent_id = 00196177_97
# text = Sen içebilirsin.

# old_sent_id = mst-5510
# sent_id = 00196177_98
# text = İmrenmem korkma.

# old_sent_id = mst-3177
# sent_id = 00196177_99
# text = Hem deney olur benim için.

# old_sent_id = mst-3236
# sent_id = 00196177_100
# text = Birasını yudumluyor, çekingen.

# old_sent_id = mst-2164
# sent_id = 00196177_101
# text = Donukluğu erimeye başladı.

# old_sent_id = mst-4799
# sent_id = 00196177_102
# text = Hiç mi ilişkisi olmadı bu kızın.

# old_sent_id = mst-2971
# sent_id = 00196177_103
# text = Yaş otuz beş.

# old_sent_id = mst-3251
# sent_id = 00196177_104
# text = Rahibe değil a...

# old_sent_id = mst-1444
# sent_id = 00196177_105
# text = Sevdiği genç trafik kazasında ölünce küsmüş hayata, teyzemden rivayet-olabilir de, insaf, on beş yıl geçmiş aradan.

# old_sent_id = mst-4873
# sent_id = 00196177_106
# text = Bir kıvılcım, yeter çözülmesine.

# old_sent_id = mst-0001
# sent_id = 00196177_107
# text = Peşreve başlamalı.

# old_sent_id = mst-2757
# sent_id = 00196177_108
# text = Uysalca bıraktı ellerini.

# old_sent_id = mst-1422
# sent_id = 00196177_109
# text = Kardeşinden yana rahatladığı için belki.

# old_sent_id = mst-0873
# sent_id = 00196177_110
# text = Nişanlanması eli kulağındaymış, yanında staj yaptığı avukatla.

# old_sent_id = mst-3606
# sent_id = 00196177_111
# text = İyi, hayırlı olsun!

# old_sent_id = mst-0388
# sent_id = 00196177_112
# text = Kızardı yanakları.

# old_sent_id = mst-1441
# sent_id = 00196177_113
# text = Ummadığı inandırıcı soğukkanlılığım, açığa vurmasına yaradı, umut beklentisini...

# old_sent_id = mst-0011
# sent_id = 00196177_114
# text = Kahveleri bende içelim.

# old_sent_id = mst-3800
# sent_id = 00196177_115
# text = Sonra çıkarsın alışverişe.

# old_sent_id = mst-3485
# sent_id = 00196177_116
# text = Olur olur...

# old_sent_id = mst-2054
# sent_id = 00196177_117
# text = Koluna girebilir miyim?

# old_sent_id = mst-5279
# sent_id = 00196177_118
# text = Yokuş çıkacağız.

# old_sent_id = mst-0372
# sent_id = 00196177_119
# text = Şaka bir yana yakıştık birbirimize.

# old_sent_id = mst-5436
# sent_id = 00196177_120
# text = Merak ediyormuş o da evimi.

# old_sent_id = mst-0216
# sent_id = 00196177_121
# text = Teyzemin bodruma kaldırttığı eski iki koltuğu, bir kanepesi, orta masası konuk odamın başlıca mobilyası.

# old_sent_id = mst-4042
# sent_id = 00196177_122
# text = DUAL pikabım var.

# old_sent_id = mst-1583
# sent_id = 00196177_123
# text = Sinan yollamıştı Almanya'dan.

# old_sent_id = mst-5001
# sent_id = 00196177_124
# text = Şostakoviç dinleteceğim sana.

# old_sent_id = mst-4991
# sent_id = 00196177_125
# text = Bale Süiti.

# old_sent_id = mst-2509
# sent_id = 00196177_126
# text = Seveceksin.

# old_sent_id = mst-3190
# sent_id = 00196177_127
# text = Bakma hoşnut görünmesine, aklı başka yerde.

# old_sent_id = mst-2991
# sent_id = 00196177_128
# text = Hele bir cigara yakalım.

# old_sent_id = mst-3071
# sent_id = 00196177_129
# text = Yo, yo olmaz.

# old_sent_id = mst-0754
# sent_id = 00196177_130
# text = Bakın soluk soluğa kaldınız.

# old_sent_id = mst-2637
# sent_id = 00196177_131
# text = Gördün mü el konulduk bile.

# old_sent_id = mst-1480
# sent_id = 00196177_132
# text = Bismillah, özgürlük gitti elden.

# old_sent_id = mst-5106
# sent_id = 00196177_133
# text = O yasak, bu yasak.

# old_sent_id = mst-1548
# sent_id = 00196177_134
# text = Ederim ben böyle yaşamanın içine!

# old_sent_id = mst-3145
# sent_id = 00196177_135
# text = Ne işin var kardeşim kız kurularıyla.

# old_sent_id = mst-0316
# sent_id = 00196177_136
# text = Bul bir fıstık kan, at evine, rahatla, derdin bu senin.

# old_sent_id = mst-4439
# sent_id = 00196177_137
# text = ?ostakoviç'miş! Tövbe yarabbi.

# old_sent_id = mst-3207
# sent_id = 00196177_138
# text = Bakalım daha nelere sokacak Grek burnunu...

# old_sent_id = mst-4025
# sent_id = 00196177_139
# text = Oh, ne güzel!

# old_sent_id = mst-3967
# sent_id = 00196177_140
# text = Nohut oda, bakla sofa.

# old_sent_id = mst-5392
# sent_id = 00196177_141
# text = Keşke benim de böyle bir evim olsa başımı sokacak.

# old_sent_id = mst-1880
# sent_id = 00196177_142
# text = Perdeler uymuyor, değiştirelim.

# old_sent_id = mst-1385
# sent_id = 00196177_143
# text = Dikkat: değiştirmeli demedi.

# old_sent_id = mst-4578
# sent_id = 00196177_144
# text = Dikmesi benden.

# old_sent_id = mst-0168
# sent_id = 00196177_145
# text = Vallahi çok şirin.

# old_sent_id = mst-1819
# sent_id = 00196177_146
# text = Mutfak daracık.

# old_sent_id = mst-4396
# sent_id = 00196177_147
# text = Duşunuz da var.

# old_sent_id = mst-5550
# sent_id = 00196177_148
# text = Eyvah! Mantara basıyoruz galiba.

# old_sent_id = mst-1524
# sent_id = 00196177_149
# text = Meğer ne hızlıymış kızımız.

# old_sent_id = mst-4534
# sent_id = 00196177_150
# text = Daha sonra! Hem çok dağınık.

# old_sent_id = mst-5530
# sent_id = 00196177_151
# text = Az kalsın kaçırıyordum ağzımdan.

# old_sent_id = mst-1595
# sent_id = 00196177_152
# text = Plağımızı koyalım mı.

# old_sent_id = mst-4888
# sent_id = 00196177_153
# text = Yanılıyor muyum yoksa.

# old_sent_id = mst-1049
# sent_id = 00196177_154
# text = Önce kahvelerimizi içelim de...

# old_sent_id = mst-5284
# sent_id = 00196177_155
# text = Kimselere güvenemem.

# old_sent_id = mst-0386
# sent_id = 00196177_156
# text = Ya boca ederler kahveyi, bir karış telve oluşur, ya cimrilikleri tutar, buyrun bulaşık suyuna.

# old_sent_id = mst-0560
# sent_id = 00196177_157
# text = Neniz var.

# old_sent_id = mst-1594
# sent_id = 00196177_158
# text = Bir şey mi dokundu.

# old_sent_id = mst-4929
# sent_id = 00196177_159
# text = Götürdü tepsiyi sessizce.

# old_sent_id = mst-3198
# sent_id = 00196177_160
# text = Derin derin soluklandım, gidip oturdum karşısındaki uzakça koltuğa.

# old_sent_id = mst-2719
# sent_id = 00196177_161
# text = Güya dinliyoruz, süzgün gözlerle.

# old_sent_id = mst-3697
# sent_id = 00196177_162
# text = Ne uzun kirpikleri var, o yeşil...

# old_sent_id = mst-3729
# sent_id = 00196177_163
# text = Alaturkanın tadı da bir başka canım.

# old_sent_id = mst-3816
# sent_id = 00196177_164
# text = Oysa yeşil değil, akik de, gitsin.

# old_sent_id = mst-3186
# sent_id = 00196177_165
# text = Sigarama davrandım, saygılıyım, ikincisine.

# old_sent_id = mst-4604
# sent_id = 00196177_166
# text = Bademcikleri alınmış.

# old_sent_id = mst-2608
# sent_id = 00196177_167
# text = Faranjiti var, kötü öksürtüyor, içmesin o.

# old_sent_id = mst-1615
# sent_id = 00196177_168
# text = Kalkıp ardına kadar açtım pencereyi.

# old_sent_id = mst-2120
# sent_id = 00196177_169
# text = Gerekmezdi ya, mersi.

# old_sent_id = mst-0668
# sent_id = 00196177_170
# text = İllet sözcük.

# old_sent_id = mst-0723
# sent_id = 00196177_171
# text = Olmaz, köylü ağzı.

# old_sent_id = mst-0134
# sent_id = 00196177_172
# text = (İzninizle, neden olmasın...

# old_sent_id = mst-0666
# sent_id = 00196177_173
# text = Plak bitince ne yapacağız?

# old_sent_id = mst-0619
# sent_id = 00196177_174
# text = Yenisine ben bile dayanamam.

# old_sent_id = mst-1394
# sent_id = 00196177_175
# text = Duvarlarla konuşmaktan bıktım.

# old_sent_id = mst-0411
# sent_id = 00196177_176
# text = Severim tartışmayı, gevezeliği, tatlı tatlı takılmayı, uyuşuyorsa kafalar.

# old_sent_id = mst-2119
# sent_id = 00196177_177
# text = Bununla neden sözedilir?

# old_sent_id = mst-3744
# sent_id = 00196177_178
# text = Okumuyorlar efendim.

# old_sent_id = mst-5374
# sent_id = 00196177_179
# text = Kaydım gitti, deli fişek çağıma.

# old_sent_id = mst-1981
# sent_id = 00196177_180
# text = Ne zaman tepem attı, kaptım bekletilen tepsiyi masadan?

# old_sent_id = mst-2639
# sent_id = 00196177_181
# text = Ayaklandı.

# old_sent_id = mst-4752
# sent_id = 00196177_182
# text = Bırakın...

# old_sent_id = mst-3527
# sent_id = 00196177_183
# text = bırakın ben götüreyim.

# old_sent_id = mst-4190
# sent_id = 00196177_184
# text = Yüzümün değişiminden ürkmüş gibi.

# old_sent_id = mst-3196
# sent_id = 00196177_185
# text = Çektim ellerimi...

# old_sent_id = mst-5172
# sent_id = 00196177_186
# text = Ne duruyorsun...

# old_sent_id = mst-4885
# sent_id = 00196177_187
# text = Tam fırsat-kararlıyım, çırpınma hiç!

# old_sent_id = mst-0971
# sent_id = 00196177_188
# text = Bitecek bu şaşkın serüven...

# old_sent_id = mst-2091
# sent_id = 00196177_189
# text = Şangır! Oldu işte, battı ortalık.

# old_sent_id = mst-0430
# sent_id = 00196177_190
# text = Nasıl da güçlü.

# old_sent_id = mst-4188
# sent_id = 00196177_191
# text = Ormandasınız, Fadime'ye saldırı sahnesi...

# old_sent_id = mst-4647
# sent_id = 00196177_192
# text = Olmuyor, tekrarlayalım...

# old_sent_id = mst-0506
# sent_id = 00196177_193
# text = Bastır pehlivan, dal çakşırına...

# old_sent_id = mst-4949
# sent_id = 00196177_194
# text = Gevşemiyor bir türlü...

# old_sent_id = mst-1622
# sent_id = 00196177_195
# text = Ayak oyunuyla bir yuvarlayabilsem kanapeye.

# old_sent_id = mst-0176
