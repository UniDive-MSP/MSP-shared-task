# old_sent_id = mst-5502
# sent_id = 00220166_31
# text = Dört parmağını gösterdi; sonra saatini.

# old_sent_id = mst-0339
# sent_id = 00220166_32
# text = Yolu yarılamıştık neredeyse.

# old_sent_id = mst-4549
# sent_id = 00220166_33
# text = Etrafımızdaki izleri sordum: Siegen diye yanıtladı.

# old_sent_id = mst-3153
# sent_id = 00220166_34
# text = Eldiveninin iç tarafındaki kürkü tutarak tekrarladı: Siegen.

# old_sent_id = mst-0317
# sent_id = 00220166_35
# text = Kutup porsuğunu (Gulo gulo l.) bu adla anıyorlardı.

# old_sent_id = mst-1636
# sent_id = 00220166_36
# text = Tüm bir kış bozulmadan kalmış karın içinde kenardan köşeden, ağaç aralarından ya da çalı diplerinden yürümüş farklı farklı hayvanların dağlarıydı buralar.

# old_sent_id = mst-2035
