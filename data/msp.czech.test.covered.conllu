# newdoc id = mf930709-094
# global.Entity = eid-etype-head-other
# newpar id = mf930709-094-p1
# sent_id = mf930709-094-p1s1
# text = Plavecký svaz chce podíl na výhrách

# sent_id = mf930709-094-p1s2
# text = TRENÉR KOČAŘ: NEJEDNEJTE SE ZÁVODNÍKY JAKO S HLUPÁKY!

# newpar id = mf930709-094-p2
# sent_id = mf930709-094-p2s1A
# text = Praha (pa) -

# sent_id = mf930709-094-p2s2
# text = Žádá to alespoň Český svaz plaveckých sportů v dopise, jímž se obrátil na všechny přední závodníky.

# sent_id = mf930709-094-p2s3
# text = Připomíná v něm, že podle pravidel Mezinárodní federace FINA by závodník měl svazu odevzdat všechny peněžní výhry, jež mu pak budou zpětně vyplaceny až po skončení jeho závodní činnosti.

# sent_id = mf930709-094-p2s4
# text = Český svaz však toto přísné pravidlo uplatňovat nehodlá, uvádí se v dopise.

# sent_id = mf930709-094-p2s5
# text = Podíl ze svých prémií odevzdává pouze plavkyně Hana Černá, u ostatních trenérů a závodníků žádost svazu, podepsaná jeho předsedou Miroslavem Šandou, vzbudila rozpaky, nelibost, až rozhořčení.

# sent_id = mf930709-094-p2s6
# text = "Jednejte se závodníky jako s partnery, a ne jako s hlupáky," píše ve své odpovědi předsedovi svazu brněnský trenér Michal Kočař.

# sent_id = mf930709-094-p2s7
# text = "Zaplaťpánbůh, že už minuly doby, kdy nejrůznější orgány rozhodovaly o soukromém majetku občanů, jímž peněžní výhry závodníků nepochybně jsou."

# sent_id = mf930709-094-p2s8
# text = Trenér Kočař míní, že tento problém lze upravit pouze smlouvou mezi závodníkem a svazem, ale žádné takové smlouvy nebyly podepsány.

# sent_id = mf930709-094-p2s10
# text = Jiří Kyněra, trenér olympijské finalistky Olgy Šplíchalové, potvrdil, že jeho svěřenkyně zatím žádné peníze svazu neodevzdala.

# sent_id = mf930709-094-p2s11
# text = "Když svaz něco chce, ať předloží závodníkům smlouvu," řekl.

# sent_id = mf930709-094-p2s12
# text = "Náš dopis apeluje na dobrou vůli," prohlašuje generální sekretářka svazu Ludmila Adlerová.

# sent_id = mf930709-094-p2s13
# text = "Vzájemné vztahy dáváme do roviny morální povinnosti, neboť svaz předním závodníkům hradí všechno včetně kapesného.

# sent_id = mf930709-094-p2s14
# text = Je to výzva k džentlmenské dohodě."

# sent_id = mf930709-094-p2s15
# text = Trenéři přesto dál hovoří o jistém druhu vypočítavosti a pozastavují se zejména nad tou částí dopisu, v níž se píše o tom, že "příspěvky umožní zahraniční starty mladším i méně úspěšným kolegům české reprezentace."

# sent_id = mf930709-094-p2s16
# text = "Co kdyby tak někdo z členů výkonného výboru svazu přispíval na tyto méně úspěšné závodníky ze svých příjmů?" klade řečnickou otázku trenér Kočař.

# sent_id = mf930709-094-p2s17
# text = V zákulisí se hovoří i o tom, že svaz na odevzdané částky nevydává žádná potvrzení a že "bůhví kam se ty peníze podějí."

# sent_id = mf930709-094-p2s18
# text = "To je čirý nesmysl," prohlašuje sekretářka Adlerová, "na jakoukoli částku potvrzení samozřejmě vydáváme.

# sent_id = mf930709-094-p2s19
# text = Podrážděnou reakci na náš dopis považuji ostatně za naprosto neadekvátní."

# newdoc id = mf930709-104
# global.Entity = eid-etype-head-other
# newpar id = mf930709-104-p1
# sent_id = mf930709-104-p1s1
# text = Nositel Čestné legie obdržel pozitivní lustrační osvědčení

# newpar id = mf930709-104-p2
# sent_id = mf930709-104-p2s1
# text = Zástupkyně mluvčího ministra vnitra Beata Berníková na náš dotaz, zda může potvrdit pozitivní lustraci profesora Svobody, odpověděla, že takové informace ministerstvo neposkytuje.

# sent_id = mf930709-104-p2s2
# text = Lustrační osvědčení jsou žadatelům zasílána do vlastních rukou a ti je předkládají svým nadřízeným.

# newpar id = mf930709-104-p3
# sent_id = mf930709-104-p3s1
# text = Profesor Svoboda, který právě působí v Itálii, nám v telefonickém rozhovoru svou pozitivní lustraci potvrdil, řekl však, že nijak nesouvisí s jeho rezignací na funkci ředitele Laterny magiky ze dne 30. května;

# sent_id = mf930709-104-p3s2
# text = administrativní místo prý nikdy nechtěl zastávat, hodlal zůstat uměleckým šéfem.

# sent_id = mf930709-104-p3s3
# text = "Mám čisté svědomí.

# sent_id = mf930709-104-p3s4
# text = Samozřejmě kolem mě kroužila spousta lidí, ale bral jsem to tak, že jsem hlídané zvíře, protože jsem jezdil každý týden někam.

# sent_id = mf930709-104-p3s6
# text = Nikdy jsem nic nepodepsal.

# sent_id = mf930709-104-p3s7
# text = Nerad bych po padesáti letech práce v Národním divadle a v Laterně magice odcházel s tímto označením, proto jsem se prostřednictvím právního zástupce obrátil na soud," řekl J. Svoboda.

# sent_id = mf930709-104-p3s8
# text = První soudní stání by se mělo konat koncem července.

# newpar id = mf930709-104-p4
# sent_id = mf930709-104-p4s1
# text = Řád Čestné legie mimo jiné obdrželi Václav Havel, Pavel Tigrid a Milan Kundera.

