# newpar id = ln95046-024-p6
# sent_id = ln95046-024-p6s1
# text = Za sledování domácích zápasů Sparty musejí fanoušci dobře zaplatit (90 Kč na hlavní tribunu, 60 Kč na krytou a 40 Kč na nekrytou).

# sent_id = ln95046-024-p6s2
# text = "Nabízíme takové služby a pohodlí, které na jiném stadiónu v republice nenajdete.

# sent_id = ln95046-024-p6s3
