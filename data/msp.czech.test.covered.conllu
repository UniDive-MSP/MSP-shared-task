# sent_id = mf920922-033-p3s1
# text = Firma zabývající se výzkumem trhu hledá spolupracovníka s velmi dobrými znalostmi z oboru farmacie.

# newpar id = mf920922-033-p4
# sent_id = mf920922-033-p4s1
# text = Vyrábí a dodává ZD Úsovsko se sídlem v Klopině

