# newdoc id = mf920922-043
# global.Entity = eid-etype-head-other
# newpar id = mf920922-043-p1
# sent_id = mf920922-043-p1s1
# text = jak bude?

# newpar id = mf920922-043-p2
# sent_id = mf920922-043-p2s1
# text = POČASÍ: V ČR bude jasno až polojasno.

# sent_id = mf920922-043-p2s2
# text = Noční teploty 10 až 6, denní 20 až 24.

