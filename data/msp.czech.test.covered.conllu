# sent_id = mf930709-125-p1s1
# text = Liberec bude asi stavět nemocnici

# newpar id = mf930709-125-p2
# sent_id = mf930709-125-p2s1A
# text = Liberec (ouš) -

# sent_id = mf930709-125-p2s1B
# text = Liberecká nemocnice se ani při rekonstrukci nemůže stát moderním zdravotnickým zařízením.

# sent_id = mf930709-125-p2s2
# text = Vedení nemocnice proto prosazuje stavbu nového areálu na kraji města.

# sent_id = mf930709-125-p2s3
# text = Nemocnice totiž leží ve středu města, kde stavbě nových budov brání hustá bytová zástavba.

# sent_id = mf930709-125-p2s4
# text = Podle technického ředitele nemocnice Milana Trpišovského by nový areál s 800 lůžky stál zhruba 1.5 miliardy korun, přibližně stejně by stálo vybavení.

