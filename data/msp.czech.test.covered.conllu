# text = Hranice povede korytem Moravy

# newpar id = mf930709-074-p2
# sent_id = mf930709-074-p2s1A
# text = Praha (km) -

# sent_id = mf930709-074-p2s1B
# text = Státní hranice mezi Českou republikou a Slovenskem by měla vést korytem řeky Moravy.

# sent_id = mf930709-074-p2s2
# text = Tato řeka dosavadní administrativní hranici mezi okresy jižní Moravy a západního Slovenska na několika místech protíná.

# sent_id = mf930709-074-p2s3
# text = Včera se na tom v Praze shodla společná česko-slovenská rozhraničovací komise.

# sent_id = mf930709-074-p2s4
# text = Při vytyčování hranice nepřijde ani jedna země o své území, protože změny na pomezí jsou založeny na principu výměny území za území.

# sent_id = mf930709-074-p2s5
# text = Státní hranice by měla být vytyčena do roku 1995.

